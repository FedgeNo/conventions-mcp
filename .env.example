# Optional — override where the SQLite database file lives.
# Default: <project>/data/memory.db in a git checkout, or ~/.conventions-mcp/memory.db
# when installed via npm — see defaultDbPath() in src/db.js.
# Windows: forward slashes work fine (e.g. C:/Users/you/memory.db) — no need
# for escaped backslashes.
# MEMORY_DB_PATH=

# Optional — override the persistent local embedding-model cache.
# Default: ~/.conventions-mcp/models
# MEMORY_MODEL_CACHE_PATH=

# Optional — run one shared localhost Streamable HTTP service instead of stdio.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=47123
# MCP_HTTP_MAX_SESSIONS=100
# MCP_HTTP_SESSION_IDLE_MS=1800000

# Optional — deadline for graceful transport shutdown before connections are
# forced closed and the process reports failure (range 1000–2147483647ms).
# MCP_SHUTDOWN_TIMEOUT_MS=10000
