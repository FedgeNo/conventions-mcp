# Required — used only for the capture_thought metadata-extraction step.
# Get one at https://openrouter.ai/settings/keys (free tier works with the
# default model pool below).
OPENROUTER_API_KEY=

# Optional — override the pool of free-tier models rotated across on each
# metadata-extraction call (comma-separated). OpenRouter's own docs recommend
# spreading load across models to avoid free-tier rate limits. Check current
# free models before changing: https://openrouter.ai/api/v1/models
# (filter for pricing.prompt == "0" and pricing.completion == "0")
# OPENROUTER_MODEL_POOL=meta-llama/llama-3.3-70b-instruct:free,google/gemma-4-31b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free,nvidia/nemotron-nano-9b-v2:free

# Optional — set to 1 or true to extract metadata against paid models instead
# of the free pool, if you'd rather pay per-token than hit free-tier rate
# limits/congestion. Default: off (uses the free pool above).
# OPENROUTER_USE_PAID_MODELS=

# Optional — override the pool of paid models used when
# OPENROUTER_USE_PAID_MODELS is on (comma-separated). Default is the same
# model families as the free pool, without the :free suffix.
# OPENROUTER_PAID_MODEL_POOL=meta-llama/llama-3.3-70b-instruct,google/gemma-4-31b-it,qwen/qwen3-next-80b-a3b-instruct,openai/gpt-oss-20b

# Optional — only relevant when OPENROUTER_USE_PAID_MODELS is on. Set to 0 or
# false to skip the free pool and go straight to paid on every call. Default:
# on — the free pool is tried first each call, since free-tier congestion is
# often transient, and paid is only used once the free pool is exhausted.
# OPENROUTER_TRY_FREE_FIRST=

# Optional — override where the SQLite database file lives.
# Default: <project>/data/memory.db in a git checkout, or ~/.conventions-mcp/memory.db
# when installed via npm — see defaultDbPath() in src/db.js.
# Windows: forward slashes work fine (e.g. C:/Users/you/memory.db) — no need
# for escaped backslashes.
# MEMORY_DB_PATH=
